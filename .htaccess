# Только для хостинга (Apache). GitHub Pages этот файл не читает
Options -Indexes
RewriteEngine On
# страница блога собирается из шаблона blog.html и записей Юлии
RewriteRule ^blog\.html$ api/blog-stranica.php [L]

# служебные файлы сайта наружу не отдаём
<FilesMatch "^(\.gitignore|README.*|.*\.(py|md|stackdump))$">
  Require all denied
</FilesMatch>
